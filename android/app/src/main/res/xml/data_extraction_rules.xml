<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: back up the game's save to the cloud and move it to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="CryptoClicker/" />
        <include domain="sharedpref" path="preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="CryptoClicker/" />
        <include domain="sharedpref" path="preferences.xml" />
    </device-transfer>
</data-extraction-rules>
